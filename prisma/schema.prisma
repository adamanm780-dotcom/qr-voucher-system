generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Cafe {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  logoUrl      String?
  primaryColor String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vouchers Voucher[]
  batches  Batch[]
}

model Batch {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  name        String
  voucherType String
  description String?
  quantity    Int
  validUntil  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vouchers Voucher[]

  @@index([cafeId])
}

model Voucher {
  id                String         @id @default(cuid())
  code              String         @unique
  cafeId            String
  cafe              Cafe           @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  batchId           String
  batch             Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  status            VoucherStatus  @default(UNUSED)
  activatedAt       DateTime?
  redeemedAt        DateTime?
  validUntil        DateTime?
  passSerialNumber  String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([code])
  @@index([cafeId])
  @@index([batchId])
  @@index([status])
}

enum VoucherStatus {
  UNUSED
  ACTIVATED
  REDEEMED
  EXPIRED
}
